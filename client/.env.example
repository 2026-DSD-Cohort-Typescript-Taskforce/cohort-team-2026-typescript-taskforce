# Every variable the client reads. Copy to client/.env; never commit it.
# Express origin that the /api/* route handlers call (server-only, not sent to the browser).
# Defaults to http://localhost:5000. Read when the Next.js server runs.
API_URL=

# Supabase, for the /api/bills route handlers, which call Supabase as the signed-in user.
# Server-only: no NEXT_PUBLIC_ prefix, so the browser never receives them. It only calls /api.
# Supabase API URL, e.g. the "API URL" from `supabase status`.
SUPABASE_URL=
# Supabase publishable (anon) key, the same one server/.env uses. Never the secret key.
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_DATA_API_BASE_URL=https://<project-ref>.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
