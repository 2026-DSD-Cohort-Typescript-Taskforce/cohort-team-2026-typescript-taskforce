# Every variable the client reads. Copy to client/.env; never commit it.
# Express origin that the /api/* route handlers call (server-only, not sent to the browser).
# Defaults to http://localhost:5000. Read when the Next.js server runs.
API_URL=
NEXT_PUBLIC_SUPABASE_DATA_API_BASE_URL=https://<project-ref>.supabase.co/rest/v1
# Supabase project origin used by one-time browser-to-Storage uploads (no /rest/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Supabase, for the /api/bills route handlers, which call Supabase as the signed-in user.
# Server-only: no NEXT_PUBLIC_ prefix, so the browser never receives them. It only calls /api.
# Supabase API URL, e.g. the "API URL" from `supabase status`.
SUPABASE_URL=
# Supabase publishable (anon) key, the same one server/.env uses. Never the secret key.
SUPABASE_PUBLISHABLE_KEY=

# Server-only connection from the manual admin trigger to the bill-mcp edge function.
# BILL_MCP_URL is the deployed function URL; BILL_MCP_TOKEN must match its shared secret.
BILL_MCP_URL=
BILL_MCP_TOKEN=

# OpenRouter, for /api/policies/[vendorId]/draft (turns a policy sentence into a draft).
# Server-only: never add a NEXT_PUBLIC_ prefix. Without a key, POST replies "unavailable".
OPENROUTER_API_KEY=
# Model id. Defaults to nvidia/nemotron-3.5-super-vl:free when empty.
OPENROUTER_POLICY_MODEL=
# API base URL. Defaults to https://openrouter.ai/api/v1 when empty.
OPENROUTER_BASE_URL=
