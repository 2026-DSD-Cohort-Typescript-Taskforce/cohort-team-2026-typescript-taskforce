# Every variable the client reads. Copy to client/.env; never commit it.
# Express origin that the /api/* route handlers call (server-only, not sent to the browser).
# Defaults to http://localhost:5000. Read when the Next.js server runs.
API_URL=
NEXT_PUBLIC_SUPABASE_DATA_API_BASE_URL=https://<project-ref>.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
