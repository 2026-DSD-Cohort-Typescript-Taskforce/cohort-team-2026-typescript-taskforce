# Every variable the server reads. Copy to server/.env and fill in locally; never commit .env.

# --- API server (npm run dev / npm start) ---
# Port to listen on. Default 5000.
PORT=5000
# Frontend origin allowed by CORS. Email change confirmation links return to its /login.
# Default http://localhost:3000.
CLIENT_URL=http://localhost:3000
# Supabase API URL, e.g. the "API URL" from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key. The server never uses the secret key.
SUPABASE_PUBLISHABLE_KEY=
# Set to production on a deployed server so session cookies are sent with Secure.
NODE_ENV=

# --- Seed scripts only. Never set the secret key on a deployed server. ---
# Local: npm run seed:local-users
SUPABASE_SECRET_KEY=
SEED_USER_PASSWORD=
# Production roster: npm run seed:prod-users
# Copy scripts/prod-users.example.json to scripts/prod-users.json and pass these on the command line.
# CONFIRM_PROD_USERS=provision-production-users
# PROD_USER_PASSWORD=
# PROD_USERS_FILE=scripts/prod-users.json

# --- Tests only (npm test). Also uses SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
# (payments-concurrency.test.ts), SEED_USER_PASSWORD, CLIENT_URL. ---
# Local Postgres URL ("DB URL" in `supabase status`). payments-concurrency.test.ts runs psql with it.
SUPABASE_DB_URL=
# Seeded login to test with. Default alex.morgan@example.com.
TEST_USER_EMAIL=
# Seeded system_admin for the invite tests (DC-55). Default sam.rivera@example.com.
TEST_ADMIN_EMAIL=
# Mailpit, where local Supabase Auth delivers email ("Mailpit URL" in `supabase status`).
# Default http://127.0.0.1:54324.
MAILPIT_URL=

# --- Stagehand worker (bill-mcp only; routes reject requests if secret is unset) ---
# Same shared secret configured in bill-mcp. Never expose it to Next.js.
STAGEHAND_SECRET=
# Absolute path to an operator-owned portal profiles JSON file; see docs/context/stagehand-worker.md.
# Observation and execution both require an exact matching profile URL.
STAGEHAND_PORTALS_FILE=
# Durable directory shared by all server processes. Default: server/.stagehand-state.
# Never delete records to retry a payment with an uncertain outcome.
STAGEHAND_STATE_DIR=
