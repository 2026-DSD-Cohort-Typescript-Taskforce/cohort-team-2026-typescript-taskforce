# Every variable the server reads. Copy to server/.env and fill in locally; never commit .env.

# --- API server (npm run dev / npm start) ---
# Port to listen on. Default 5000.
PORT=
# Frontend origin allowed by CORS. Default http://localhost:3000.
CLIENT_URL=
# Supabase API URL, e.g. the "API URL" from `supabase status`.
SUPABASE_URL=
# Supabase publishable (anon) key. The server never uses the secret key.
SUPABASE_PUBLISHABLE_KEY=
# Set to production on a deployed server so session cookies are sent with Secure.
NODE_ENV=

# --- Local seed script only (npm run seed:local-users). Never set on a deployed server. ---
SUPABASE_SECRET_KEY=
SEED_USER_PASSWORD=

# --- Tests only (npm test). Also uses SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SEED_USER_PASSWORD. ---
# Seeded login to test with. Default alex.morgan@example.com.
TEST_USER_EMAIL=
